{
  "name": "@aurafhe/mcp",
  "version": "0.4.0",
  "description": "AURA Encrypted MCP — the access layer for ciphertext AI. One line connects Cursor, Claude, and any agent to the AURA coprocessor.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp": "dist/index.js",
    "aura-fhe": "dist/index.js",
    "aura-fhe-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "prepublishOnly": "npm run build",
    "test": "tsc && tsx --test src/*.test.ts",
    "start": "node dist/index.js",
    "check": "bash scripts/check-network.sh",
    "launch": "bash scripts/launch.sh",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "fhe",
    "ai",
    "private-ai",
    "homomorphic",
    "aura",
    "encrypted-compute",
    "cursor",
    "claude"
  ],
  "author": "Mochi Labs <gen@afhe.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aurafhe/mcp.git"
  },
  "bugs": {
    "url": "https://github.com/aurafhe/mcp/issues"
  },
  "homepage": "https://afhe.io",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.0.0"
  },
  "optionalDependencies": {
    "undici": "^6.21.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
